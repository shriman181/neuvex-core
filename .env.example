# Copy to .env and fill in. Never commit .env.
#
# Connection string for the neuvex_migrator role. For local work use the `dev`
# branch's direct (non-pooled) address, never production:
#   Neon Console -> Branches -> dev -> Connect, turn off "Connection pooling",
#   then put neuvex_migrator and its password between // and @.
DATABASE_URL=postgresql://neuvex_migrator:PASSWORD@ep-DEV-ENDPOINT.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
