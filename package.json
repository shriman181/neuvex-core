{
  "name": "neuvex-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Neuvex core: control plane, gateway and sandbox infrastructure on Neon Postgres.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run generate -w @neuvex/db --",
    "db:migrate": "npm run migrate -w @neuvex/db",
    "db:check": "npm run check -w @neuvex/db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:seed:demo": "npm run seed:demo -w @neuvex/db --",
    "gateway:dev": "npm run dev -w @neuvex/gateway",
    "gateway:deploy": "npm run deploy -w @neuvex/gateway",
    "db:create-key": "npm run create-key -w @neuvex/db --",
    "db:ensure-key": "npm run ensure-key -w @neuvex/db --",
    "playground:preview": "npm run preview -w @neuvex/playground"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0",
    "tsx": "^4.23.15"
  }
}
